# LLM provider: gemini (default) or groq
LLM_PROVIDER=gemini

# Gemini provider
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash

# Groq provider (used when LLM_PROVIDER=groq)
GROQ_API_KEY=replace_me

# Optional pool for independently authorized Groq organizations/projects.
# Comma-separated; do not use this to bypass one organization's quota.
# GROQ_API_KEYS=gsk_key_for_org_a,gsk_key_for_org_b
# Alternatively: GROQ_API_KEY_1=..., GROQ_API_KEY_2=...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
# Keep completion budgets below low-tier TPM limits.
GROQ_REASONING_TOKEN_BUDGET=512
GROQ_MAX_OUTPUT_TOKENS=2048

# Invite-only pilot accounts. Legacy key mode is local/operator-only.
INSURECLEAR_AUTH_MODE=accounts
INSURECLEAR_AUTH_DB=data/auth.sqlite3
INSURECLEAR_AUTH_COOKIE_SECURE=true
# For explicit localhost HTTP development ONLY, set AUTH_COOKIE_SECURE=false.
INSURECLEAR_REQUIRE_AUTH=true
# Only used if AUTH_MODE=legacy, never in browser builds.
INSURECLEAR_API_KEY=replace_me_with_a_long_random_value
INSURECLEAR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Request and queue controls
INSURECLEAR_MAX_UPLOAD_BYTES=15728640
INSURECLEAR_MAX_TEXT_CHARS=500000
INSURECLEAR_RATE_LIMIT_REQUESTS=10
INSURECLEAR_RATE_LIMIT_WINDOW_SECONDS=60
INSURECLEAR_JOB_DB=data/jobs.sqlite3

# Frontend build-time values
VITE_API_BASE_URL=

# Conservative UTF-8 byte upper bounds for model context (not exact token counts)
INSURECLEAR_PROMPT_BUDGET=16000
INSURECLEAR_CHUNK_UNITS=1200
INSURECLEAR_CHUNK_OVERLAP=120
INSURECLEAR_REGULATORY_BUDGET=3500

# Single-host admission and cooperative stage-boundary case limits
INSURECLEAR_MAX_PENDING_JOBS=100
INSURECLEAR_MAX_PENDING_PER_USER=3
INSURECLEAR_CASE_TIMEOUT_SECONDS=300
INSURECLEAR_CASE_MAX_CALLS=20
INSURECLEAR_CASE_MAX_TOKENS=60000

# Digital/OCR page caps; OCR uses one raster page at a time with bounded timeouts.
INSURECLEAR_MAX_PDF_PAGES=200
INSURECLEAR_MAX_OCR_PAGES=40

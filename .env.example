# Gemini provider
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash

# API security. Set both values in production.
INSURECLEAR_REQUIRE_AUTH=false
INSURECLEAR_API_KEY=replace_me_with_a_long_random_value
INSURECLEAR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Request and queue controls
INSURECLEAR_MAX_UPLOAD_BYTES=15728640
INSURECLEAR_MAX_TEXT_CHARS=500000
INSURECLEAR_RATE_LIMIT_REQUESTS=10
INSURECLEAR_RATE_LIMIT_WINDOW_SECONDS=60
INSURECLEAR_JOB_DB=data/jobs.sqlite3

# Frontend build-time values
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=
